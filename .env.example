# LOCAL DEV ONLY. Without this, plain `npm run dev` still works but is
# limited to GitHub's unauthenticated rate limit (60 requests / 10
# searches per hour). This variable is bundled into the browser JS,
# so never set it in a deployed build — see the "Production setup"
# section in README for the secure option.
VITE_GITHUB_TOKEN=

# PRODUCTION. Used only by the serverless functions in api/github.js
# (Vercel) and netlify/functions/github.js (Netlify). Stays server-side,
# never reaches the browser. Set this in your host's environment
# variables dashboard, not in a committed .env file.
GITHUB_TOKEN=

# REQUIRED for the Projects feature (browsing /projects, the admin
# workspace at /admin, everything in src/lib/projectsStore.js and
# src/lib/adminAuth.js). Get both from your Supabase project's
# dashboard → Project Settings → API. Unlike GITHUB_TOKEN above, these
# ARE meant to be public / bundled into the browser — Supabase's anon
# key is designed for that; real protection comes from the Row Level
# Security policies in supabase/schema.sql, not from hiding this key.
# Set both locally here AND in Vercel's Environment Variables for the
# deployed site. See README.md → Projects → Supabase setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
